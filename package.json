{
  "name": "emaki-ai",
  "version": "0.1.0",
  "description": "Official SDK for emaki (emaki.ai), the Japanese-language AI video generator for Seedance 2.5 and Seedance 2.0",
  "type": "module",
  "main": "./dist/mod.js",
  "types": "./dist/mod.d.ts",
  "exports": { ".": { "types": "./dist/mod.d.ts", "default": "./dist/mod.js" } },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": { "node": ">=18" },
  "keywords": ["ai", "video-generation", "text-to-video", "image-to-video", "seedance", "seedance-2-5", "image-generation", "emaki"],
  "homepage": "https://emaki.ai/?utm_source=npm&utm_medium=package",
  "repository": { "type": "git", "url": "git+https://github.com/hanshs474/emaki-ts.git" },
  "bugs": "https://github.com/hanshs474/emaki-ts/issues",
  "license": "MIT",
  "author": "emaki",
  "scripts": {
    "build": "tsc mod.ts --outDir dist --declaration --target es2022 --module es2022 --moduleResolution bundler --lib es2022,dom --skipLibCheck",
    "test": "node --test test.mjs"
  }
}
